{
  "expo": {
    "name": "Exercise Timer",
    "slug": "exercise-timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1115",
    "android": {
      "package": "com.namrata.exercisetimer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F1115"
      },
      "permissions": ["WAKE_LOCK"]
    },
    "plugins": ["expo-audio"]
  }
}
